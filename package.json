{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "build": "pnpm --filter @blxzer/pactile build",
    "test": "pnpm --filter @blxzer/pactile test",
    "lint": "pnpm --filter @blxzer/pactile lint",
    "typecheck": "pnpm --filter @blxzer/pactile typecheck",
    "release": "pnpm --filter @blxzer/pactile release",
    "release:minor": "pnpm --filter @blxzer/pactile release:minor",
    "release:major": "pnpm --filter @blxzer/pactile release:major",
    "release:beta": "pnpm --filter @blxzer/pactile release:beta",
    "release:promote": "pnpm --filter @blxzer/pactile release:promote",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions",
    "release:plan": "node packages/cli/scripts/release-preflight.js publish-plan",
    "docs:smoke": "pnpm --filter @blxzer/pactile docs:smoke"
  }
}
