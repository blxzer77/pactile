{
  "name": "@blxzer/cursor-trellis-core",
  "version": "0.5.0",
  "description": "Deprecated compatibility shim for @blxzer/pactile-core",
  "type": "module",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.ts",
      "import": "./index.js",
      "default": "./index.js"
    },
    "./task": {
      "types": "./task.d.ts",
      "import": "./task.js",
      "default": "./task.js"
    },
    "./testing": {
      "types": "./testing.d.ts",
      "import": "./testing.js",
      "default": "./testing.js"
    }
  },
  "files": [
    "index.js",
    "index.d.ts",
    "task.js",
    "task.d.ts",
    "testing.js",
    "testing.d.ts"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@blxzer/pactile-core": "workspace:*"
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "license": "AGPL-3.0-only"
}
